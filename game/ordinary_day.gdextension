[configuration]

entry_symbol = "ordinary_day_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug.arm64 = "res://bin/libordinaryday.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libordinaryday.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://bin/libordinaryday.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/libordinaryday.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://bin/libordinaryday.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libordinaryday.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libordinaryday.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libordinaryday.linux.template_release.x86_64.so"
