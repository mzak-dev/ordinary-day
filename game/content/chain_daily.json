{
	// Praca w kawiarni, komputer i gildia, deszcz w środę, drobne czynności.
	"actions": [
		{ "id": "wait", "label": "Poczekaj (15 min)", "group": "czekanie", "cost": 1, "effects": [] },
		{ "id": "wait_hour", "label": "Poczekaj (1 h)", "group": "czekanie", "cost": 4, "effects": [ "$battery+=1" ] },
		{ "id": "sleep", "label": "Idź spać", "loc": "room", "group": "pokój", "cost": 0, "sleep": true,
			"requires": [ { "if": [ "$time>=20:00" ], "why": "Za wcześnie. I tak byś nie zasnął." } ],
			"text": { "cold": "Sufit. Telefon. Sufit.", "warm": "Zasypiasz szybciej niż zwykle." } },
		{ "id": "nap", "label": "Drzemka (1 h)", "loc": "room", "group": "pokój", "cost": 4, "limit": "daily",
			"when": [ "$time<20:00" ], "effects": [ "$energy+=20", "$battery+=4" ], "text": "Budzisz się z odciśniętą poduszką na policzku i poczuciem, że minęły trzy dni." },
		{ "id": "play_short", "label": "Pograj na komputerze (1 h)", "loc": "room", "group": "komputer", "cost": 4,
			"effects": [ "add:game_hours=1", "$mood+=3", "$battery+=2" ],
			"text": { "cold": "Jeszcze jedna runda. Wygrana. Przegrana. Jeszcze jedna.", "warm": "Godzinka grania. Zasłużyłeś." } },
		{ "id": "play_long", "label": "Wsiąknij w grę (3 h)", "loc": "room", "group": "komputer", "cost": 12,
			"effects": [ "add:game_hours=3", "add:mom_worry=1", "$mood+=5", "$energy-=6", "$battery+=4" ],
			"text": { "cold": "Za oknem zmienia się światło. W grze zawsze jest ta sama pora dnia.", "warm": "Trzy godziny. Gildia się cieszy, ty trochę mniej, niż myślałeś." } },
		{ "id": "commission_work", "label": "Rób ikony dla Wiedźmy_77 (2 h)", "loc": "room", "group": "komputer", "cost": 8,
			"when": [ "guild_offer", "!commission_paid", "!commission_lost" ],
			"requires": [ { "if": [ "$energy>=15" ], "why": "Kreska ci się trzęsie. Odpocznij." } ],
			"effects": [ "add:commission=1", "$energy-=10", "$mood+=4" ],
			"text": "Miecz, tarcza, mikstura. Piksel po pikselu. To pierwsza rzecz od dawna, którą robisz dla kogoś." },
		{ "id": "doomscroll", "label": "Przewijaj telefon", "group": "telefon", "cost": 2,
			"when": [ "item:phone" ], "effects": [ "$mood-=2", "$battery+=2" ],
			"text": "Wojny, przepisy na ciasto, ktoś z liceum ma dziecko. Kciuk przewija sam." },

		{ "id": "shift_tue", "label": "Zmiana w kawiarni (16–20)", "loc": "cafe", "group": "praca", "cost": 16, "limit": "once",
			"when": [ "day:tue", "$time>=15:30", "$time<=16:30", "!fired" ],
			"effects": [ "set:worked_tue", "$money+=120", "$energy-=15", "$battery-=8" ],
			"text": { "cold": "Latte, flat white, latte, „a macie roślinne?”. Uśmiechasz się mechanicznie przez cztery godziny.", "warm": "Pan Zbyszek puszcza jazz z kasety. Stała klientka zostawia ci napiwek i komplement dla piany." } },
		{ "id": "shift_sat", "label": "Zmiana w kawiarni (10–16)", "loc": "cafe", "group": "praca", "cost": 24, "limit": "once",
			"when": [ "day:sat", "$time>=09:30", "$time<=10:30", "!fired" ],
			"effects": [ "set:worked_sat", "$money+=180", "$energy-=20", "$battery-=10" ],
			"text": "Sobota. Kolejka do drzwi. Ekspres syczy jak zmęczony smok." },
		{ "id": "cafe_coffee", "label": "Kup kawę (9 zł)", "loc": "cafe", "group": "zakupy", "cost": 1, "limit": "daily",
			"requires": [ { "if": [ "item:wallet" ], "why": "Portfel został w domu." }, { "if": [ "$money>=9" ], "why": "Nie masz pieniędzy." } ],
			"effects": [ "$energy+=15", "$money-=9", "$mood+=2" ], "text": "Pan Zbyszek daje ci zniżkę pracowniczą. Nawet jak nie masz zmiany." },

		{ "id": "buy_energy", "label": "Kup energetyka (7 zł)", "loc": "shop", "group": "zakupy", "cost": 1,
			"requires": [ { "if": [ "item:wallet" ], "why": "Portfel został w domu." }, { "if": [ "$money>=7" ], "why": "Nie masz pieniędzy." } ],
			"effects": [ "$energy+=15", "$money-=7", "$mood-=1" ], "text": "Smak: „tropikalna burza”. Serce: też burza." },
		{ "id": "buy_snack", "label": "Kup coś słodkiego (6 zł)", "loc": "shop", "group": "zakupy", "cost": 1,
			"requires": [ { "if": [ "item:wallet" ], "why": "Portfel został w domu." }, { "if": [ "$money>=6" ], "why": "Nie masz pieniędzy." } ],
			"effects": [ "$mood+=4", "$money-=6" ], "text": "Kasjerka pyta, czy aplikacja. Nie, dziękuję. Zawsze „nie, dziękuję”." },
		{ "id": "walk_osiedle", "label": "Przejdź się bez celu (30 min)", "loc": "osiedle", "group": "spacer", "cost": 2,
			"effects": [ "$mood+=2", "$battery+=1" ], "text": "Trzepak, piaskownica, ten sam kot co zawsze. Osiedle jest jak stary sweter." },
		{ "id": "sit_bench", "label": "Posiedź na ławce (30 min)", "loc": "park", "group": "spacer", "cost": 2,
			"effects": [ "$battery+=5", "$mood+=2" ],
			"text": { "cold": "Gołębie. Ktoś biega. Nikt niczego od ciebie nie chce.", "warm": "Starszy pan obok karmi kaczki i komentuje każdą z osobna. Kaczka Zdzisława jest jego ulubioną." } },
		{ "id": "read_book", "label": "Czytaj książkę (1 h)", "loc": "park", "group": "spacer", "cost": 4,
			"requires": [ { "if": [ "item:book" ], "why": "Książka została na biurku." } ],
			"effects": [ "$battery+=10", "$mood+=6", "set:read_in_park" ], "text": "„Rzeczy, których nie wyrzuciłem”, rozdział siódmy. Ten o ojcu. Zawsze w tym miejscu robisz przerwę." }
	],

	"rules": [
		{ "id": "missed_tue", "label": "Nie przyszedłeś na zmianę (wtorek)", "when": [ "day:tue", "$time>=17:00", "!worked_tue" ],
			"effects": [ "add:missed_shifts=1", "phone:szef_tue|Pan Zbyszek|Gdzie jesteś? Zmiana od 16. Raz przymknę oko." ] },
		{ "id": "missed_sat", "label": "Nie przyszedłeś na zmianę (sobota)", "when": [ "day:sat", "$time>=11:00", "!worked_sat" ],
			"effects": [ "add:missed_shifts=1", "phone:szef_sat|Pan Zbyszek|Znowu? Sobota, kolejka do drzwi, a ciebie nie ma." ] },
		{ "id": "fired", "label": "Zwolnienie", "when": [ "missed_shifts>=2" ],
			"effects": [ "set:fired", "$mood-=10", "phone:szef_fired|Pan Zbyszek|Nie przychodź już. Rozliczę cię przelewem. Szkoda, bo piana ci wychodziła." ] },
		{ "id": "ola_visits_cafe", "label": "Ola wpada do kawiarni", "when": [ "at:cafe", "npc:ola@cafe", "knows_ola" ],
			"effects": [ "$rel.ola+=10", "$warmth+=8", "set:ola_cafe" ],
			"text": "Dzwonek nad drzwiami. Ola: „Kuba mówił, że tu pracujesz!” Robisz jej latte z sercem z piany. Wychodzi krzywe. Ola i tak robi zdjęcie." },

		{ "id": "guild_offer", "label": "Wiedźma_77 proponuje zlecenie", "when": [ "game_hours>=6", "$day<=4", "at:room" ],
			"effects": [ "set:guild_offer" ],
			"text": "Discord: Wiedźma_77 z gildii: „Robisz grafiki, nie? Potrzebuję 12 ikon do moda. 400 zł. Na sobotę. Dasz radę?”" },
		{ "id": "commission_done", "label": "Zlecenie oddane", "when": [ "commission>=2" ],
			"effects": [ "set:commission_paid", "$money+=400", "$warmth+=3", "$mood+=8" ],
			"text": "Wiedźma_77: „Są PIĘKNE. Przelew poszedł. Serio, dzięki. Wrzucę cię do creditsów.”" },
		{ "id": "commission_lost", "label": "Zlecenie przepadło", "when": [ "guild_offer", "!commission_paid", "$day>=6" ],
			"effects": [ "set:commission_lost" ], "text": "Wiedźma_77 jest offline. Ostatnia wiadomość: „Ok, nieważne, znalazłam kogoś.”" },
		{ "id": "diamond", "label": "Ranga Diament", "when": [ "game_hours>=12" ],
			"effects": [ "set:diamond", "$mood+=5" ], "text": "DIAMENT. Ekran wybucha konfetti. W pokoju jest cicho." },

		{ "id": "rain_wet", "label": "Przemokłeś", "when": [ "weather:rain", "at:osiedle,bus_stop,park,kampus", "!item:umbrella", "!got_wet" ],
			"effects": [ "set:got_wet", "$mood-=5" ], "text": "Ulewa. Przemakasz w trzydzieści sekund. Skarpetki chlupią przy każdym kroku." },
		{ "id": "rain_umbrella", "label": "Parasol", "when": [ "weather:rain", "at:osiedle,bus_stop,park,kampus", "item:umbrella" ],
			"effects": [ "set:umbrella_used" ], "text": "Rozkładasz parasol. Deszcz bębni nad głową jak w namiocie. Prawie przyjemnie." },
		{ "id": "sick", "label": "Przeziębienie",
			"when": [ "got_wet" ], "delay": { "days": 1, "at": "07:00" },
			"check": [ "!warm_tea" ],
			"effects": [ "set:sick", "$energy-=30", "$mood-=8" ],
			"text": "Gardło jak papier ścierny, głowa jak z waty. Przeziębienie.",
			"else_text": "Gardło trochę drapie, ale wczorajsza herbata zrobiła swoje." }
	]
}
